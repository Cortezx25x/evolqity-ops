PORT=3001
HOST=127.0.0.1
NODE_ENV=development

DATABASE_URL="postgresql://evolqity_ops_dev_user:CHANGE_ME@127.0.0.1:5433/evolqity_ops_dev?schema=public"
TEST_DATABASE_URL="postgresql://evolqity_ops_test_user:CHANGE_ME@127.0.0.1:5433/evolqity_ops_test?schema=public"

AUTH_ACCESS_TOKEN_SECRET="CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_PEPPER="CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
AUTH_SESSION_TTL_DAYS=30

AUTH_JWT_ISSUER=evolqity-ops-api
AUTH_JWT_AUDIENCE=evolqity-ops

AUTH_REFRESH_COOKIE_NAME=evolqity_rt
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_LOGIN_RATE_LIMIT_MAX=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

PUBLIC_ESTIMATE_BASE_URL=http://localhost:5173/estimate
PUBLIC_ESTIMATE_TOKEN_PEPPER="CHANGE_ME_WITH_A_DISTINCT_RANDOM_VALUE_OF_AT_LEAST_48_CHARACTERS"
PUBLIC_ESTIMATE_TOKEN_TTL_DAYS=30
PUBLIC_ESTIMATE_VIEW_RATE_LIMIT_MAX=60
PUBLIC_ESTIMATE_VIEW_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_ESTIMATE_DECISION_RATE_LIMIT_MAX=10
PUBLIC_ESTIMATE_DECISION_RATE_LIMIT_WINDOW_SECONDS=60

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=false

MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_ROOT="./data/media"
MEDIA_MAX_FILE_SIZE_BYTES=10485760