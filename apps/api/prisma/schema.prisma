generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum PlatformRole {
  PLATFORM_ADMIN
}

enum CustomerType {
  PERSON
  COMPANY
}

enum AssetType {
  VEHICLE
  EQUIPMENT
  DEVICE
  OTHER
}

enum WorkOrderStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  WAITING
  COMPLETED
  CANCELLED
}

enum WorkOrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum InspectionStatus {
  DRAFT
  COMPLETED
}

enum InspectionItemCondition {
  OK
  ATTENTION
  FAIL
  NOT_APPLICABLE
}

enum EstimateStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  CANCELLED
}

enum EstimateItemType {
  LABOR
  PART
  SERVICE
  OTHER
}

enum PublicEstimateDecision {
  APPROVED
  REJECTED
}

model Organization {
  id                  String   @id @default(uuid()) @db.Uuid
  name                String
  slug                String   @unique
  type                String?
  active              Boolean  @default(true)
  nextWorkOrderNumber Int      @default(1)
  nextEstimateNumber  Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  members     OrganizationUser[] @relation("OrganizationMemberships")
  customers   Customer[]
  assets      Asset[]
  workOrders  WorkOrder[]
  inspections Inspection[]
  media                 Media[]
  estimates             Estimate[]
  estimatePublicTokens  EstimatePublicToken[]
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique
  firstName    String?
  lastName     String?
  passwordHash String?
  platformRole PlatformRole?
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  organizations OrganizationUser[] @relation("UserMemberships")
  sessions      AuthSession[]
}

model OrganizationUser {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  role           OrganizationRole @default(MEMBER)
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation("OrganizationMemberships", fields: [organizationId], references: [id])
  user         User         @relation("UserMemberships", fields: [userId], references: [id])

  assignedWorkOrders   WorkOrder[]  @relation("WorkOrderAssignee")
  createdWorkOrders    WorkOrder[]  @relation("WorkOrderCreator")
  createdInspections   Inspection[] @relation("InspectionCreator")
  completedInspections Inspection[] @relation("InspectionCompleter")
  uploadedMedia            Media[]               @relation("MediaUploader")
  createdEstimates         Estimate[]            @relation("EstimateCreator")
  createdEstimatePublicTokens EstimatePublicToken[] @relation("EstimatePublicTokenCreator")

  @@unique([organizationId, userId])
  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([userId])
}

model Customer {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  type           CustomerType @default(PERSON)
  name           String
  identification String?
  email          String?
  phone          String?
  notes          String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assets       Asset[]
  workOrders   WorkOrder[]

  @@index([organizationId])
  @@index([organizationId, active])
}

model Asset {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  customerId     String    @db.Uuid
  type           AssetType @default(VEHICLE)
  name           String
  identifier     String?
  plate          String?
  vin            String?
  serialNumber   String?
  make           String?
  model          String?
  year           Int?
  color          String?
  notes          String?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  workOrders   WorkOrder[]

  @@index([organizationId])
  @@index([organizationId, customerId])
  @@index([organizationId, active])
  @@index([organizationId, type])
  @@index([organizationId, plate])
  @@index([organizationId, vin])
}

model WorkOrder {
  id                     String            @id @default(uuid()) @db.Uuid
  organizationId         String            @db.Uuid
  number                 Int
  customerId             String            @db.Uuid
  assetId                String?           @db.Uuid
  status                 WorkOrderStatus   @default(OPEN)
  priority               WorkOrderPriority @default(NORMAL)
  title                  String
  description            String?
  diagnosis              String?
  resolution             String?
  internalNotes          String?
  assignedToMembershipId String?           @db.Uuid
  createdByMembershipId  String            @db.Uuid
  scheduledAt            DateTime?
  startedAt              DateTime?
  completedAt            DateTime?
  cancelledAt            DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  asset        Asset?            @relation(fields: [assetId], references: [id], onDelete: Restrict)
  assignedTo   OrganizationUser? @relation("WorkOrderAssignee", fields: [assignedToMembershipId], references: [id], onDelete: SetNull)
  createdBy    OrganizationUser  @relation("WorkOrderCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  inspections  Inspection[]
  media        Media[]
  estimates    Estimate[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, customerId])
  @@index([organizationId, assetId])
  @@index([organizationId, assignedToMembershipId])
  @@index([organizationId, createdAt])
}

model Inspection {
  id                      String           @id @default(uuid()) @db.Uuid
  organizationId          String           @db.Uuid
  workOrderId             String           @db.Uuid
  title                   String
  notes                   String?
  status                  InspectionStatus @default(DRAFT)
  nextItemOrder           Int              @default(1)
  createdByMembershipId   String           @db.Uuid
  completedByMembershipId String?          @db.Uuid
  completedAt             DateTime?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrder    WorkOrder         @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  createdBy    OrganizationUser  @relation("InspectionCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  completedBy  OrganizationUser? @relation("InspectionCompleter", fields: [completedByMembershipId], references: [id], onDelete: SetNull)
  items        InspectionItem[]
  media        Media[]

  @@index([organizationId, workOrderId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

model InspectionItem {
  id           String                   @id @default(uuid()) @db.Uuid
  inspectionId String                   @db.Uuid
  label        String
  description  String?
  condition    InspectionItemCondition?
  notes        String?
  sortOrder    Int
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  media      Media[]

  @@index([inspectionId, sortOrder])
}

model Estimate {
  id                    String         @id @default(uuid()) @db.Uuid
  organizationId        String         @db.Uuid
  workOrderId           String         @db.Uuid
  number                Int
  status                EstimateStatus @default(DRAFT)
  currency              String
  notes                 String?
  terms                 String?
  validUntil            DateTime?
  subtotal              Decimal        @default(0) @db.Decimal(14, 2)
  discountTotal         Decimal        @default(0) @db.Decimal(14, 2)
  taxTotal              Decimal        @default(0) @db.Decimal(14, 2)
  total                 Decimal        @default(0) @db.Decimal(14, 2)
  nextItemOrder         Int            @default(1)
  createdByMembershipId String         @db.Uuid
  sentAt                DateTime?
  approvedAt            DateTime?
  rejectedAt            DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrder    WorkOrder        @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  createdBy            OrganizationUser      @relation("EstimateCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  items                EstimateItem[]
  publicEstimateTokens EstimatePublicToken[]

  @@unique([organizationId, number])
  @@unique([id, organizationId])
  @@index([organizationId, workOrderId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

model EstimateItem {
  id              String           @id @default(uuid()) @db.Uuid
  estimateId      String           @db.Uuid
  type            EstimateItemType
  description     String
  quantity        Decimal          @db.Decimal(12, 3)
  unitPrice       Decimal          @db.Decimal(14, 2)
  discountPercent Decimal          @default(0) @db.Decimal(5, 2)
  taxPercent      Decimal          @default(0) @db.Decimal(5, 2)
  subtotal        Decimal          @db.Decimal(14, 2)
  discountAmount  Decimal          @db.Decimal(14, 2)
  taxableAmount   Decimal          @db.Decimal(14, 2)
  taxAmount       Decimal          @db.Decimal(14, 2)
  total           Decimal          @db.Decimal(14, 2)
  sortOrder       Int
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId, sortOrder])
}

model Media {
  id                     String   @id @default(uuid()) @db.Uuid
  organizationId         String   @db.Uuid
  workOrderId            String?  @db.Uuid
  inspectionId           String?  @db.Uuid
  inspectionItemId       String?  @db.Uuid
  storageKey             String   @unique
  originalName           String
  mimeType               String
  sizeBytes              Int
  sha256                 String
  caption                String?
  uploadedByMembershipId String   @db.Uuid
  createdAt              DateTime @default(now())

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workOrder      WorkOrder?       @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  inspection     Inspection?      @relation(fields: [inspectionId], references: [id], onDelete: Restrict)
  inspectionItem InspectionItem?  @relation(fields: [inspectionItemId], references: [id], onDelete: Restrict)
  uploadedBy     OrganizationUser @relation("MediaUploader", fields: [uploadedByMembershipId], references: [id], onDelete: Restrict)

  @@index([organizationId, workOrderId])
  @@index([organizationId, inspectionId])
  @@index([organizationId, inspectionItemId])
  @@index([organizationId, createdAt])
}

model AuthSession {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?
  lastUsedAt    DateTime?
  userAgent     String?
  createdIp     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model EstimatePublicToken {
  id                    String                  @id @default(uuid()) @db.Uuid
  organizationId        String                  @db.Uuid
  estimateId            String                  @db.Uuid
  secretHash            Bytes                   @unique
  expiresAt             DateTime
  revokedAt             DateTime?
  revokedReason         String?
  decision              PublicEstimateDecision?
  decidedAt             DateTime?
  responderName         String?
  rejectionReason       String?
  createdByMembershipId String                  @db.Uuid
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  estimate     Estimate         @relation(fields: [estimateId, organizationId], references: [id, organizationId], onDelete: Cascade)
  createdBy    OrganizationUser @relation("EstimatePublicTokenCreator", fields: [createdByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, estimateId])
  @@index([estimateId, revokedAt])
  @@index([expiresAt])
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  sessionId         String    @db.Uuid
  tokenHash         Bytes     @unique
  expiresAt         DateTime
  usedAt            DateTime?
  revokedAt         DateTime?
  replacedByTokenId String?   @unique @db.Uuid
  createdAt         DateTime  @default(now())

  session    AuthSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("RefreshTokenRotation", fields: [replacedByTokenId], references: [id])
  replaces   RefreshToken? @relation("RefreshTokenRotation")

  @@index([sessionId, revokedAt])
  @@index([expiresAt])
}
