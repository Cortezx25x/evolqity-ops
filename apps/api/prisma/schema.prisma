generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum CustomerType {
  PERSON
  COMPANY
}

enum AssetType {
  VEHICLE
  EQUIPMENT
  DEVICE
  OTHER
}

enum WorkOrderStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  WAITING
  COMPLETED
  CANCELLED
}

enum WorkOrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum InspectionStatus {
  DRAFT
  COMPLETED
}

enum InspectionItemCondition {
  OK
  ATTENTION
  FAIL
  NOT_APPLICABLE
}

model Organization {
  id                  String   @id @default(uuid()) @db.Uuid
  name                String
  slug                String   @unique
  type                String?
  active              Boolean  @default(true)
  nextWorkOrderNumber Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  members     OrganizationUser[] @relation("OrganizationMemberships")
  customers   Customer[]
  assets      Asset[]
  workOrders  WorkOrder[]
  inspections Inspection[]
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  firstName    String?
  lastName     String?
  passwordHash String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organizations OrganizationUser[] @relation("UserMemberships")
  sessions      AuthSession[]
}

model OrganizationUser {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  role           OrganizationRole @default(MEMBER)
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation("OrganizationMemberships", fields: [organizationId], references: [id])
  user         User         @relation("UserMemberships", fields: [userId], references: [id])

  assignedWorkOrders   WorkOrder[]  @relation("WorkOrderAssignee")
  createdWorkOrders    WorkOrder[]  @relation("WorkOrderCreator")
  createdInspections   Inspection[] @relation("InspectionCreator")
  completedInspections Inspection[] @relation("InspectionCompleter")

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model Customer {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  type           CustomerType @default(PERSON)
  name           String
  identification String?
  email          String?
  phone          String?
  notes          String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assets       Asset[]
  workOrders   WorkOrder[]

  @@index([organizationId])
  @@index([organizationId, active])
}

model Asset {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  customerId     String    @db.Uuid
  type           AssetType @default(VEHICLE)
  name           String
  identifier     String?
  plate          String?
  vin            String?
  serialNumber   String?
  make           String?
  model          String?
  year           Int?
  color          String?
  notes          String?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  workOrders   WorkOrder[]

  @@index([organizationId])
  @@index([organizationId, customerId])
  @@index([organizationId, active])
  @@index([organizationId, type])
  @@index([organizationId, plate])
  @@index([organizationId, vin])
}

model WorkOrder {
  id                     String            @id @default(uuid()) @db.Uuid
  organizationId         String            @db.Uuid
  number                 Int
  customerId             String            @db.Uuid
  assetId                String?           @db.Uuid
  status                 WorkOrderStatus   @default(OPEN)
  priority               WorkOrderPriority @default(NORMAL)
  title                  String
  description            String?
  diagnosis              String?
  resolution             String?
  internalNotes          String?
  assignedToMembershipId String?           @db.Uuid
  createdByMembershipId  String            @db.Uuid
  scheduledAt            DateTime?
  startedAt              DateTime?
  completedAt            DateTime?
  cancelledAt            DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  asset        Asset?            @relation(fields: [assetId], references: [id], onDelete: Restrict)
  assignedTo   OrganizationUser? @relation("WorkOrderAssignee", fields: [assignedToMembershipId], references: [id], onDelete: SetNull)
  createdBy    OrganizationUser  @relation("WorkOrderCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  inspections  Inspection[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, customerId])
  @@index([organizationId, assetId])
  @@index([organizationId, assignedToMembershipId])
  @@index([organizationId, createdAt])
}

model Inspection {
  id                      String           @id @default(uuid()) @db.Uuid
  organizationId          String           @db.Uuid
  workOrderId             String           @db.Uuid
  title                   String
  notes                   String?
  status                  InspectionStatus @default(DRAFT)
  nextItemOrder           Int              @default(1)
  createdByMembershipId   String           @db.Uuid
  completedByMembershipId String?          @db.Uuid
  completedAt             DateTime?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrder    WorkOrder         @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  createdBy    OrganizationUser  @relation("InspectionCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  completedBy  OrganizationUser? @relation("InspectionCompleter", fields: [completedByMembershipId], references: [id], onDelete: SetNull)
  items        InspectionItem[]

  @@index([organizationId, workOrderId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

model InspectionItem {
  id           String                   @id @default(uuid()) @db.Uuid
  inspectionId String                   @db.Uuid
  label        String
  description  String?
  condition    InspectionItemCondition?
  notes        String?
  sortOrder    Int
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId, sortOrder])
}

model AuthSession {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?
  lastUsedAt    DateTime?
  userAgent     String?
  createdIp     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  sessionId         String    @db.Uuid
  tokenHash         Bytes     @unique
  expiresAt         DateTime
  usedAt            DateTime?
  revokedAt         DateTime?
  replacedByTokenId String?   @unique @db.Uuid
  createdAt         DateTime  @default(now())

  session    AuthSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("RefreshTokenRotation", fields: [replacedByTokenId], references: [id])
  replaces   RefreshToken? @relation("RefreshTokenRotation")

  @@index([sessionId, revokedAt])
  @@index([expiresAt])
}
