# Template only. Replace certificate paths and verify with `nginx -t`.
server {
    listen 80;
    listen [::]:80;
    server_name portal.evolqity.com;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name portal.evolqity.com;

    ssl_certificate /etc/letsencrypt/live/portal.evolqity.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/portal.evolqity.com/privkey.pem;

    # Keep HSTS enabled only after HTTPS and certificate renewal are verified.
    root /var/www/evolqity-ops/current/apps/web/dist;
    index index.html;

    # The API accepts 10 MiB files; allow multipart framing overhead.
    client_max_body_size 12m;

    # Registration creates an OWNER and organization. Keep it off the public
    # Internet after controlled pilot onboarding.
    location = /api/auth/register {
        add_header Cache-Control "no-store" always;
        return 404;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;

        # API responses can contain authentication or capability-protected data.
        proxy_hide_header Cache-Control;
        add_header Cache-Control "private, no-store" always;
        # Enable after HTTPS and renewal checks:
        # add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
    }

    location / {
        # Required for /login, /estimate, and every /app/* browser refresh.
        try_files $uri $uri/ /index.html;

        # Enable after HTTPS and renewal checks:
        # add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    # Do not create an alias for MEDIA_LOCAL_ROOT. Media is authorized and
    # streamed only by GET /api/media/:id/content.
}
