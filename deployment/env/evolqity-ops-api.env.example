# Copy to /etc/evolqity-ops/api.env, restrict to root and the API service
# account, and replace every CHANGE_ME value. Never commit the real file.
NODE_ENV=production
HOST=127.0.0.1
PORT=3001

DATABASE_URL=postgresql://evolqity_ops_app:CHANGE_ME@127.0.0.1:5432/evolqity_ops_prod?schema=public

# Generate each value independently, for example: openssl rand -base64 48
AUTH_ACCESS_TOKEN_SECRET=CHANGE_ME_WITH_A_UNIQUE_HIGH_ENTROPY_VALUE
AUTH_REFRESH_TOKEN_PEPPER=CHANGE_ME_WITH_A_DIFFERENT_HIGH_ENTROPY_VALUE
PUBLIC_ESTIMATE_TOKEN_PEPPER=CHANGE_ME_WITH_ANOTHER_HIGH_ENTROPY_VALUE

AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_SESSION_TTL_DAYS=30
AUTH_JWT_ISSUER=evolqity-ops-api
AUTH_JWT_AUDIENCE=evolqity-ops
AUTH_REFRESH_COOKIE_NAME=__Secure-evolqity_rt
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax
AUTH_LOGIN_RATE_LIMIT_MAX=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

PUBLIC_ESTIMATE_BASE_URL=https://portal.evolqity.com/estimate
PUBLIC_ESTIMATE_TOKEN_TTL_DAYS=30
PUBLIC_ESTIMATE_VIEW_RATE_LIMIT_MAX=60
PUBLIC_ESTIMATE_VIEW_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_ESTIMATE_DECISION_RATE_LIMIT_MAX=10
PUBLIC_ESTIMATE_DECISION_RATE_LIMIT_WINDOW_SECONDS=60

CORS_ORIGINS=https://portal.evolqity.com
TRUST_PROXY=true

MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_ROOT=/var/lib/evolqity-ops/media
MEDIA_MAX_FILE_SIZE_BYTES=10485760
